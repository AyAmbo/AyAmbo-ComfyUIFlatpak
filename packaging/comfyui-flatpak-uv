#!/usr/bin/env bash
set -euo pipefail

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
PROFILE="${COMFYUI_FLATPAK_PROFILE:-default}"
PROFILE_SAFE="$(printf '%s' "$PROFILE" | tr -c 'A-Za-z0-9_.-' '_' | sed 's/^_*//; s/_*$//')"
[ -n "$PROFILE_SAFE" ] || PROFILE_SAFE=default
if [ "$PROFILE_SAFE" = "default" ]; then
  DEFAULT_PY_USER_BASE="$DATA_HOME/python"
else
  DEFAULT_PY_USER_BASE="$DATA_HOME/python-profiles/$PROFILE_SAFE"
fi
PY_USER_BASE="${COMFYUI_FLATPAK_PY_USER_BASE:-$DEFAULT_PY_USER_BASE}"

mkdir -p "$PY_USER_BASE" "$CACHE_HOME/uv"
export PYTHONUSERBASE="$PY_USER_BASE"
export PATH="$PYTHONUSERBASE/bin:/app/bin:$PATH"
export PYTHONPATH="/app/share/comfyui${PYTHONPATH:+:$PYTHONPATH}"
export UV_CACHE_DIR="$CACHE_HOME/uv"

if [ "${1:-}" = "pip" ]; then
  shift
  SUBCOMMAND="${1:-}"
  case "$SUBCOMMAND" in
    install|uninstall|sync|list|freeze|show)
      shift
      # These options belong to the subcommand, not the `uv pip` group.
      exec python3 -m uv pip "$SUBCOMMAND" --system --prefix "$PY_USER_BASE" "$@"
      ;;
    check|tree)
      shift
      # uv has no --prefix support for these read-only interpreter checks.
      exec python3 -m uv pip "$SUBCOMMAND" --system "$@"
      ;;
    *)
      # Help, compile and unknown arguments retain uv's own parsing/exit codes.
      exec python3 -m uv pip "$@"
      ;;
  esac
fi

exec python3 -m uv "$@"
