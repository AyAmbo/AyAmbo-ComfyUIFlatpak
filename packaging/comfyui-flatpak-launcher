#!/usr/bin/env bash
set -euo pipefail

COMFY_ROOT=/app/share/comfyui
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_BASE="${XDG_CACHE_HOME:-$HOME/.cache}"

PROFILE="${COMFYUI_FLATPAK_PROFILE:-default}"
PASSTHROUGH_ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile)
      if [ "$#" -lt 2 ]; then
        echo "Missing value for --profile" >&2
        exit 2
      fi
      PROFILE="$2"
      shift 2
      ;;
    --profile=*)
      PROFILE="${1#--profile=}"
      shift
      ;;
    *)
      PASSTHROUGH_ARGS+=("$1")
      shift
      ;;
  esac
done
set -- "${PASSTHROUGH_ARGS[@]}"

PROFILE_SAFE="$(printf '%s' "$PROFILE" | tr -c 'A-Za-z0-9_.-' '_' | sed 's/^_*//; s/_*$//')"
if [ -z "$PROFILE_SAFE" ]; then
  PROFILE_SAFE=default
fi

if [ "$PROFILE_SAFE" = "default" ]; then
  DATA_ROOT="$DATA_HOME/ComfyUI"
  CONFIG_ROOT="$CONFIG_HOME/ComfyUI"
  CACHE_ROOT="$CACHE_BASE/ComfyUI"
  PY_USER_BASE="$DATA_HOME/python"
else
  DATA_ROOT="$DATA_HOME/ComfyUI-profiles/$PROFILE_SAFE"
  CONFIG_ROOT="$CONFIG_HOME/ComfyUI-profiles/$PROFILE_SAFE"
  CACHE_ROOT="$CACHE_BASE/ComfyUI-profiles/$PROFILE_SAFE"
  PY_USER_BASE="$DATA_HOME/python-profiles/$PROFILE_SAFE"
fi

mkdir -p \
  "$DATA_ROOT/models/checkpoints" \
  "$DATA_ROOT/models/configs" \
  "$DATA_ROOT/models/loras" \
  "$DATA_ROOT/models/vae" \
  "$DATA_ROOT/models/text_encoders" \
  "$DATA_ROOT/models/clip" \
  "$DATA_ROOT/models/diffusion_models" \
  "$DATA_ROOT/models/unet" \
  "$DATA_ROOT/models/clip_vision" \
  "$DATA_ROOT/models/style_models" \
  "$DATA_ROOT/models/embeddings" \
  "$DATA_ROOT/models/diffusers" \
  "$DATA_ROOT/models/vae_approx" \
  "$DATA_ROOT/models/controlnet" \
  "$DATA_ROOT/models/t2i_adapter" \
  "$DATA_ROOT/models/gligen" \
  "$DATA_ROOT/models/upscale_models" \
  "$DATA_ROOT/models/latent_upscale_models" \
  "$DATA_ROOT/models/hypernetworks" \
  "$DATA_ROOT/models/photomaker" \
  "$DATA_ROOT/models/classifiers" \
  "$DATA_ROOT/models/model_patches" \
  "$DATA_ROOT/models/audio_encoders" \
  "$DATA_ROOT/models/background_removal" \
  "$DATA_ROOT/models/frame_interpolation" \
  "$DATA_ROOT/models/geometry_estimation" \
  "$DATA_ROOT/models/optical_flow" \
  "$DATA_ROOT/models/detection" \
  "$DATA_ROOT/custom_nodes" \
  "$DATA_ROOT/input" \
  "$DATA_ROOT/output" \
  "$DATA_ROOT/user" \
  "$DATA_ROOT/user/__manager" \
  "$CONFIG_ROOT" \
  "$CACHE_ROOT" \
  "$CACHE_ROOT/temp" \
  "$CACHE_BASE/pip" \
  "$CACHE_BASE/uv" \
  "$CACHE_BASE/huggingface" \
  "$CACHE_BASE/torch" \
  "$CACHE_BASE/nv/ComputeCache" \
  "$PY_USER_BASE"

# ComfyUI 0.24.0 errors if --extra-model-paths-config points at an empty or
# comment-only YAML file. Seed a real Flatpak model mapping, but preserve any
# user-edited config that already contains top-level YAML keys.
if [ ! -f "$CONFIG_ROOT/extra_model_paths.yaml" ] || ! grep -Eq '^[[:space:]]*[A-Za-z0-9_-]+:' "$CONFIG_ROOT/extra_model_paths.yaml"; then
  cat > "$CONFIG_ROOT/extra_model_paths.yaml" <<EOF
comfyui_flatpak:
  base_path: $DATA_ROOT
  is_default: true
  checkpoints: models/checkpoints
  configs: models/configs
  loras: models/loras
  vae: models/vae
  text_encoders: |
    models/text_encoders
    models/clip
  clip_vision: models/clip_vision
  style_models: models/style_models
  embeddings: models/embeddings
  diffusion_models: |
    models/diffusion_models
    models/unet
  diffusers: models/diffusers
  vae_approx: models/vae_approx
  controlnet: models/controlnet
  t2i_adapter: models/t2i_adapter
  gligen: models/gligen
  upscale_models: models/upscale_models
  latent_upscale_models: models/latent_upscale_models
  hypernetworks: models/hypernetworks
  photomaker: models/photomaker
  classifiers: models/classifiers
  model_patches: models/model_patches
  audio_encoders: models/audio_encoders
  background_removal: models/background_removal
  frame_interpolation: models/frame_interpolation
  geometry_estimation: models/geometry_estimation
  optical_flow: models/optical_flow
  detection: models/detection
EOF
fi

export PYTHONUSERBASE="$PY_USER_BASE"
export PATH="$PYTHONUSERBASE/bin:/app/bin:$PATH"
export PYTHONPATH="$COMFY_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PIP_USER=1
export PIP_REQUIRE_VIRTUALENV=false
export PIP_CACHE_DIR="$CACHE_BASE/pip"
export UV_CACHE_DIR="$CACHE_BASE/uv"
export GIT_PYTHON_GIT_EXECUTABLE=/app/bin/git
export HF_HOME="${HF_HOME:-$CACHE_BASE/huggingface}"
export HUGGINGFACE_HUB_CACHE="${HUGGINGFACE_HUB_CACHE:-$HF_HOME/hub}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME/transformers}"
export TORCH_HOME="${TORCH_HOME:-$CACHE_BASE/torch}"
export CUDA_CACHE_PATH="${CUDA_CACHE_PATH:-$CACHE_BASE/nv/ComputeCache}"
export COMFYUI_PATH="$COMFY_ROOT"
export COMFYUI_FOLDERS_BASE_PATH="$DATA_ROOT"
export HF_HUB_DISABLE_TELEMETRY=1
export DO_NOT_TRACK=1
# Helpful for NVIDIA container-like environments; harmless when ignored.
export NVIDIA_DRIVER_CAPABILITIES="${NVIDIA_DRIVER_CAPABILITIES:-compute,utility,graphics}"

# ComfyUI-Manager can use uv for pip operations, but uv currently targets the
# immutable system prefix for commands like `uv pip install package` unless extra
# flags are supplied by the caller. Keep uv available for users/extensions, while
# making Manager default to pip so PIP_USER/PYTHONUSERBASE route installs into
# the writable Flatpak data layer.
MANAGER_CONFIG="$DATA_ROOT/user/__manager/config.ini"
if [ ! -f "$MANAGER_CONFIG" ]; then
  cat > "$MANAGER_CONFIG" <<'EOF'
[default]
use_uv = False
EOF
else
  if grep -Eq '^use_uv[[:space:]]*=' "$MANAGER_CONFIG"; then
    sed -i 's/^use_uv[[:space:]]*=.*/use_uv = False/' "$MANAGER_CONFIG"
  else
    printf '\nuse_uv = False\n' >> "$MANAGER_CONFIG"
  fi
fi

export COMFYUI_FLATPAK_PROFILE="$PROFILE_SAFE"
export COMFYUI_FLATPAK_DATA_ROOT="$DATA_ROOT"
export COMFYUI_FLATPAK_CONFIG_ROOT="$CONFIG_ROOT"
export COMFYUI_FLATPAK_CACHE_ROOT="$CACHE_ROOT"
export COMFYUI_FLATPAK_PY_USER_BASE="$PY_USER_BASE"

if [ "${COMFYUI_FLATPAK_AUTO_INSTALL_REQUIREMENTS:-1}" != "0" ]; then
  /app/bin/comfyui-install-requirements || true
fi

# Run from the writable profile root, not from /app/share/comfyui. Some custom
# nodes use relative paths such as models/Qwen for model downloads; keeping the
# working directory under /app would make those writes fail with EROFS.
cd "$DATA_ROOT"

echo "ComfyUI Flatpak"
echo "  URL:        http://127.0.0.1:8188"
echo "  Data:       $DATA_ROOT"
echo "  Models:     $DATA_ROOT/models"
echo "  Extensions: $DATA_ROOT/custom_nodes"
echo "  Profile:    $PROFILE_SAFE"
echo "  Python user packages: $PYTHONUSERBASE"
echo

exec python3 "$COMFY_ROOT/main.py" \
  --enable-manager \
  --base-directory "$DATA_ROOT" \
  --temp-directory "$CACHE_ROOT" \
  --extra-model-paths-config "$CONFIG_ROOT/extra_model_paths.yaml" \
  --database-url "sqlite:///$DATA_ROOT/user/comfyui.db" \
  "$@"
